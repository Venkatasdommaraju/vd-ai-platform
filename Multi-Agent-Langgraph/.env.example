# Copy to .env and fill in to enable LLM-generated answers.
# Leave everything unset to run in offline mode.

LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=hf_your_token_here
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Leave ELASTICSEARCH_URL empty to use the built-in TF-IDF retriever.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=kb
TOP_K=4

MAX_REVISIONS=2

# Set a LangSmith key to enable tracing.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multi-agent-langgraph
